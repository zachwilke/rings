# Maintainer: Zach Wilke <zach@pinefall.dev>
# Binary package: wraps the static musl GitHub Release, no rust/cargo.
pkgname=rings-bin
pkgver=0.3.1
pkgrel=1
pkgdesc="DaisyDisk-style disk usage TUI"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/zachwilke/rings"
license=('MIT')
provides=('rings')
conflicts=('rings')
options=('!strip' '!debug')
# Rename each arch asset to rings.xz so xz -d yields a file named rings.
source_x86_64=("rings.xz::https://github.com/zachwilke/rings/releases/download/v${pkgver}/rings-x86_64-linux-musl.xz")
source_aarch64=("rings.xz::https://github.com/zachwilke/rings/releases/download/v${pkgver}/rings-aarch64-linux-musl.xz")
source_armv7h=("rings.xz::https://github.com/zachwilke/rings/releases/download/v${pkgver}/rings-armv7-linux-musleabihf.xz")
source=("LICENSE::https://raw.githubusercontent.com/zachwilke/rings/v${pkgver}/LICENSE")
sha256sums=('7d6bbd30b08d7d81fd006d07e78daf0f73fe24ec36ec44e85ac1e13d74b58a49')
sha256sums_x86_64=('110558a71d279c3beb4f759641c5effea8b44d4e9e6e7914f1be7130da7432d8')
sha256sums_aarch64=('6a07c2e9b2ca43f2a6e6e151c8f53f8f5b319ecc84c92ac00891284085139349')
sha256sums_armv7h=('108e926a27afd95c44610f78aa1236c2b892c31bd5586322d13c803308fa2770')

package() {
	install -Dm755 "$srcdir/rings" "$pkgdir/usr/bin/rings"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
